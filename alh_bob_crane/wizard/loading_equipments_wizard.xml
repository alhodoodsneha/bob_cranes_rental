<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loading_equipment_wizard_form_view" model="ir.ui.view">
        <field name="name">loading.equipment.wizard.form.view</field>
        <field name="model">loading.equipment.wizard</field>
        <field name="arch" type="xml">
            <form string="Loading Work">
                <group>
                    <field name="project_id" invisible="1"/>
                    <field name="task_id" invisible="1"/>
                    <field name="type_load"/>
                    <field name="allowed_equipment_ids" invisible="1"/>
                    <field name="equipment_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_assign_to" type="object"
                            string="Assign" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_loading_equipment_wizard_wizard" model="ir.actions.act_window">
        <field name="name">Equipment Loading Status Update</field>
        <field name="res_model">loading.equipment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="loading_equipment_wizard_form_view"/>
    </record>
</odoo>