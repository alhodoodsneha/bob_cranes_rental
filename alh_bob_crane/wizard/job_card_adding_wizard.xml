<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="job_card_adding_wizard_form_view" model="ir.ui.view">
        <field name="name">job.card.adding.wizard.form.view</field>
        <field name="model">job.card.adding.wizard</field>
        <field name="arch" type="xml">
            <form string="Job Card">
                <group>
                    <field name="sale_order" invisible="1"/>
                    <field name="user_id" required="1"/>
                </group>
                <footer>
                    <button name="action_assign_to" type="object"
                            string="Assign" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_job_card_adding_wizard_wizard" model="ir.actions.act_window">
        <field name="name">Job Card Creation</field>
        <field name="res_model">job.card.adding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="job_card_adding_wizard_form_view"/>
    </record>
</odoo>