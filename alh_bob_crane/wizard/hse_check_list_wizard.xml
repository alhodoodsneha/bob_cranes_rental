<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hse_checklist_wizard_form_view" model="ir.ui.view">
        <field name="name">hse.checklist.wizard.form.view</field>
        <field name="model">hse.checklist.wizard</field>
        <field name="arch" type="xml">
            <form string="Hse Checklist">
                <group>
                    <field name="project_id" invisible="1"/>
                    <field name="checklist_ids" widget="many2many_tags" required="1"/>
                    <field name="deadline" required="1"/>
                </group>
                <footer>
                    <button name="action_assign_to" type="object"
                            string="Assign" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hse_checklist_wizard_wizard" model="ir.actions.act_window">
        <field name="name">Hse Checklist</field>
        <field name="res_model">hse.checklist.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="hse_checklist_wizard_form_view"/>
    </record>
</odoo>