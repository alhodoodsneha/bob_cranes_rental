<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lpo_adding_wizard_form_view" model="ir.ui.view">
        <field name="name">lpo.adding.wizard.form.view</field>
        <field name="model">lpo.adding.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign To">
                <group>
                    <field name="lpo_number" required="1"/>
                     <field name="attachment_ids" widget="many2many_binary" required="1"/>
                </group>
                <footer>
                    <button name="action_assign_to" type="object"
                            string="Assign" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lpo_adding_wizard_wizard" model="ir.actions.act_window">
        <field name="name">Lpo Attach</field>
        <field name="res_model">lpo.adding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="project_assign_wizard_form_view"/>
    </record>
</odoo>