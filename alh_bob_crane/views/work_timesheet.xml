<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_work_timesheet_form" model="ir.ui.view">
    <field name="name">work.timesheet.form</field>
    <field name="model">work.timesheet</field>
    <field name="arch" type="xml">
        <form string="Work Timesheet">
            <header>
                <field name="state" widget="statusbar" readonly="1"/>

                <button name="action_submit"
                        string="Submit"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                <button name="action_approve"
                        string="Approve"
                        type="object"
                         invisible="state != 'submitted'"
                        class="btn-success"/>
                 <button name="action_print_timesheet"
                        string="Print Timesheet"
                        type="object"
                        class="btn-success"/>
            </header>

            <sheet>
                <group>
                    <group>
                        <field name="project_id" required="1" readonly="state == 'approved'"/>
                    </group>
                    <group>
                        <field name="state" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                </group>

                <notebook>
                    <page string="Timesheet Lines">
                        <field name="line_ids" readonly="state == 'approved'">
                            <list editable="bottom">
                                <field name="date"/>
                                <field name="no_of_vehicle"/>
                                <field name="timesheet_id" column_invisible="1"/>
                                <field name="task_id" column_invisible="1"/>
                                <field name="project_id" column_invisible="1"/>
                                <field name="allowed_employee_ids" column_invisible="1"/>
                                <field name="employee_id"
                                       domain="[('id','in', allowed_employee_ids)]"/>
                                  <field name="name"/>
                                <field name="employee_badge" column_invisible="1"/>
                                <field name="hours"/>
                                <field name="operator_hours"/>
                                <field name="total_hours" sum="Total Cost Amount"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
              <chatter/>
        </form>
    </field>
</record>

    <record id="view_work_timesheet_tree" model="ir.ui.view">
        <field name="name">work.timesheet.tree</field>
        <field name="model">work.timesheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="state"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>


     <record id="action_work_timesheet" model="ir.actions.act_window">
        <field name="name">Work Timesheet</field>
        <field name="res_model">work.timesheet</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_work_timesheet_tree"/>
        <field name="help" type="html">
            <p>
                Create and manage your Work Timesheet
            </p>
        </field>
    </record>


    <menuitem
            name="Work Timesheet"
            id="menu_work_timesheet_main_menu"
            parent="hr_timesheet.timesheet_menu_root"
            groups="hr_timesheet.group_hr_timesheet_user"
            sequence="14"
    >

    <menuitem
            name="Work Timesheet"
            id="menu_work_timesheet"
            action="action_work_timesheet"
            groups="hr_timesheet.group_hr_timesheet_user"
            sequence="5"
    />
    </menuitem>

</odoo>