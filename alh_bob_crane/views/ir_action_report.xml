<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_inspection_task" model="ir.actions.report">
        <field name="name">Inspection Report</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alh_bob_crane.report_inspection_fsm</field>
        <field name="report_file">alh_bob_crane.report_inspection_fsm</field>
        <field name="print_report_name">'Inspection Report - %s' % (object.name)</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">report</field>
    </record>

     <record id="action_report_timesheet" model="ir.actions.report">
        <field name="name">Timesheet Report</field>
        <field name="model">work.timesheet.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alh_bob_crane.report_timesheet_worked_report</field>
        <field name="report_file">alh_bob_crane.report_timesheet_worked_report</field>
        <field name="print_report_name">'Timesheet  Report'</field>
        <field name="binding_model_id" ref="alh_bob_crane.model_work_timesheet_line"/>
        <field name="binding_type">report</field>
    </record>
</odoo>