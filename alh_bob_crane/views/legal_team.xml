<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Legal Team Form View -->
    <record id="view_legal_team_form" model="ir.ui.view">
        <field name="name">legal.team.form</field>
        <field name="model">legal.team</field>
        <field name="arch" type="xml">
            <form string="Legal Team">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="team_manager_id"/>
                    </group>
                    <group name="Members">
                        <field name="team_member_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Legal Team Tree View -->
    <record id="view_legal_team_tree" model="ir.ui.view">
        <field name="name">legal.team.tree</field>
        <field name="model">legal.team</field>
        <field name="arch" type="xml">
            <list string="Legal Teams">
                <field name="name"/>
                <field name="team_manager_id"/>
                <field name="team_member_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>


    <record id="action_legal_team" model="ir.actions.act_window">
        <field name="name">Legal Teams</field>
        <field name="res_model">legal.team</field>
        <field name="view_mode">list,form</field>
         <field name="view_id" ref="view_legal_team_tree"/>
        <field name="help" type="html">
            <p>
                Create and manage your property legal team
            </p>
        </field>
    </record>

    <menuitem id="menu_legal_team" name="Legal Teams"
              parent="alh_bob_crane.menu_configuration_legal_case"
              action="action_legal_team"/>
</odoo>