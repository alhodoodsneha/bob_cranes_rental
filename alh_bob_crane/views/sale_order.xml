<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit_xplatform" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.xplatform</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                   <field name="crm_lead_id" readonly="1"/>
                   <field name="parent_order" invisible="1"/>
                   <field name="revision_count" invisible="1"/>
                   <field name="lpo_added" invisible="1"/>
                   <field name="create_job" invisible="1"/>
                   <field name="job_project_id" invisible="create_job == False" readonly="1"/>
                   <field name="lpo_number" readonly="1"  invisible="lpo_added == False"/>
                   <field name="lpo_attachment_ids" readonly="1"  widget="many2many_binary"  invisible="lpo_added == False"/>
            </xpath>
              <xpath expr="//header" position="inside">
                   <button name="action_revision_sales_estimation"
                        type="object"
                        string="Revision"
                        invisible="state not in ['draft','sent']"
                        class="btn btn-primary"
                        data-hotkey="d"
                />
                  <button name="action_attach_lpo"
                        type="object"
                        string="Attach Lpo"
                        invisible="state not in ['sale'] or lpo_added == True"
                        class="btn btn-primary"
                        data-hotkey="d"
                />
                   <button name="action_create_job_card"
                        type="object"
                        string="Create Job Card"
                        invisible="state not in ['sale'] or create_job == True"
                        class="btn btn-primary"
                        data-hotkey="d"
                />
              </xpath>
              <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="LPO Attached"
                        bg_color="text-bg-success"
                        invisible="lpo_added == False"/>
            </xpath>
        </field>
    </record>
</odoo>