                parent="project.menu_main_pm"
                sequence="10"
        />


    <menuitem
            name="Operation Planning"
            id="menu_opertaion_planning"
            active="True"
             web_icon="alh_bob_crane,static/description/iconp.png"
            groups="alh_bob_crane.group_operations_planning_manager,alh_bob_crane.group_operations_planning_user"
            sequence="20">

        <menuitem
                name="Operation Planning"
                id="menu_opertaion_planning_child"
