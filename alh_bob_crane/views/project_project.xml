        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="equipment_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="loading_status"/>
            </list>
        </field>
    </record>

    <record id="equipment_allocation_gantt_view" model="ir.ui.view">
    <field name="name">equipment.allocation.gantt</field>
    <field name="model">equipment.allocation</field>
        <field name="arch" type="xml">
            <gantt
                string="Equipment Planning"
                date_start="start_date"
