    <record id="manpower_allocation_tree_view" model="ir.ui.view">
    <field name="name">manpower.allocation.tree</field>
    <field name="model">manpower.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="job_id"/>
                <field name="employee_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

        <record id="manpower_allocation_gantt_view" model="ir.ui.view">
        <field name="name">manpower.allocation.gantt</field>
        <field name="model">manpower.allocation</field>
        <field name="arch" type="xml">
            <gantt
                string="Manpower Planning"
                date_start="start_date"
                date_stop="end_date"
                default_group_by="employee_id">
                <field name="employee_id"/>
                <field name="job_id"/>
