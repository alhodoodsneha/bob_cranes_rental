        </field>
        </record>

     <menuitem
                name="Equipment Allocation"
                id="menu_equipment_allocation"
                 parent="project.menu_main_pm"
                action="action_equipment_allocation"
                sequence="10"
        />
         <menuitem
                name="Manpower Allocation"
                id="menu_manpower_allocation"
