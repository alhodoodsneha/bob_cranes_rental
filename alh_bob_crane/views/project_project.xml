                            <field name="is_installed" invisible="1"/>
                            <field name="is_unloaded" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="equipment_allocation_calendar_view" model="ir.ui.view">
