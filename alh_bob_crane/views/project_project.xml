    <record id="manpower_allocation_form_view" model="ir.ui.view">
        <field name="name">manpower.allocation.form</field>
        <field name="model">manpower.allocation</field>
        <field name="arch" type="xml">
            <form string="Manpower Allocation">
                    <sheet>
