    <menuitem
            name="Inspection Task"
            id="menu_inspection_task"
            action="action_inspection_task"
            parent="project.menu_main_pm"
            groups="alh_bob_crane.group_inspection_user,alh_bob_crane.group_inspection_manager"
            sequence="8"
    />
