<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="documents_document_form_bob_crane" model="ir.ui.view">
    <field name="name">documents.document.form.bob.crane</field>
    <field name="model">documents.document</field>
    <field name="arch" type="xml">
        <form string="Document">
            <header>
                <field name="active" invisible="1"/>
            </header>

            <sheet>
                <!-- Title -->
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="Document Name"/>
                    </h1>
                </div>

                <!-- Main Info -->
                <group>
                    <group>
                         <field name="attachment_id"/>
                        <field name="folder_id"/>
                        <field name="owner_id" widget="many2one_avatar_user"/>
                        <field name="partner_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>

                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="lock_uid" readonly="1"/>
                        <field name="user_permission" readonly="1"/>
                    </group>
                </group>
                <group string="Expiry">
                    <group>
                           <field name="is_expiry"/>
                           <field name="expiry_date"/>
                           <field name="issue_date"/>
                    </group>
                    <group>
                         <field name="notification_type"/>
                         <field name="before_days"
                                   invisible="notification_type == 'single'"/>
                         <field name="notification_to" widget="many2many_tags"/>
                    </group>
                </group>

                <!-- File Information -->
                <group string="File Information">
                    <group>
                        <field name="file_extension" readonly="1"/>
                        <field name="file_size" widget="document_size" readonly="1"/>
                        <field name="mimetype" readonly="1"/>
                    </group>

                    <group>
                        <field name="create_date" readonly="1"/>
                        <field name="write_date" readonly="1"/>
                    </group>
                </group>

                <!-- Link Information -->
                <group string="Linked Record">
                    <group>
                        <field name="res_model" readonly="1"/>
                        <field name="res_model_name" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                        <field name="res_name" readonly="1"/>
                    </group>
                </group>

                <!-- URL -->
                <group string="External Link" invisible="url == False">
                    <field name="url"/>
                    <field name="access_url" readonly="1"/>
                </group>

            </sheet>

            <!-- Chatter -->
            <chatter/>
        </form>
    </field>
</record>

    <record id="documents_document_expiry_list" model="ir.ui.view">
    <field name="name">documents.document.expiry.list</field>
    <field name="model">documents.document</field>
    <field name="arch" type="xml">
        <list default_order="expiry_date asc" editable="top">
            <field name="name"/>
              <field name="attachment_id" readonly="1"/>
            <field name="folder_id" readonly="1"/>
            <field name="partner_id" readonly="1"/>
            <field name="is_expiry"/>
            <field name="issue_date"/>
            <field name="expiry_date"/>
            <field name="notification_type"/>
            <field name="before_days"/>
            <field name="owner_id" widget="many2one_avatar_user" readonly="1"/>
            <field name="company_id" groups="base.group_multi_company"/>
        </list>
    </field>
</record>

    <record id="action_documents_expiry" model="ir.actions.act_window">
    <field name="name">Document Expiry</field>
    <field name="res_model">documents.document</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="documents_document_expiry_list"/>
    <field name="context">{}</field>
   </record>

    <menuitem
    id="menu_documents_expiry"
    name="Document Expiry"
    parent="documents.menu_root"
    action="action_documents_expiry"
    sequence="50"
    groups="documents.group_documents_user"/>




    <record id="documents_view_list_main_oppor_inherit_bob_crane" model="ir.ui.view">
        <field name="name">documents.document.list.inherit.bobcrane</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list_main"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="is_expiry"/>
                    <field name="expiry_date"/>
                    <field name="issue_date"/>
                    <field name="notification_type"/>
                    <field name="before_days"
                                   invisible="notification_type == 'single'"/>
                    <field name="notification_to" widget="many2many_tags"/>
            </xpath>
             <xpath expr="//list" position="attributes">
                    <attribute name="editable">bottom</attribute>
             </xpath>
        </field>
    </record>


        <record id="documents.document_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="path">documents</field>
        <field name="res_model">documents.document</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('documents.document_view_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('documents.documents_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('alh_bob_crane.documents_document_form_bob_crane')}),
            (0, 0, {'view_mode': 'activity', 'view_id': ref('documents.documents_view_activity')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload <span class="fw-normal">a file or</span> drag <span class="fw-normal">it here.</span></p>
        </field>
    </record>

</odoo>