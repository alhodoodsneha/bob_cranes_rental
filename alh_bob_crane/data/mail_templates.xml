<?xml version="1.0"?>
<odoo>
    <data>
        <record id="mail_crm_salesperson_inspection_complete" model="mail.template">
            <field name="name">Inspection Completion Mail To Salesman</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="partner_to" eval="False"/>
            <field name="subject">Inspection Completed : {{object.crm_lead_id.name}}</field>
            <field name="email_to" eval="False"/>
            <field name="use_default_to" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="ctx.get('user_name')"/> ,</p>
                    <a t-att-href="object.get_base_url() + '/web#id=' + str(object.crm_lead_id.id) + '&amp;model=crm.lead&amp;view_type=form'"
                       style="
                            display:inline-block;
                            padding:10px 18px;
                            background-color:#875A7B;
                            color:#ffffff !important;
                            text-decoration:none;
                            border-radius:5px;
                            font-weight:600;
                            font-size:14px;
                       ">
                        View
                    </a>
                    <br/>
                    <p>Greetings from the Inspection Team.</p>
                    <p>We would like to inform you that the inspection for your enquiry <strong><t t-out="object.crm_lead_id.sequence_code"/>- <t t-out="object.crm_lead_id.name"/></strong> has been successfully completed</p>
                    <p>Please let us know if you require any further details, reports, or support from our side to proceed with the next steps</p>
                    <br/>
                    <p>Thank you for your coordination.<br/>Best regards,<br/> Inspection Team <br></br><t t-out="object.company_id.name"/></p>
                </div>
                <field name="report_template_ids" eval="[(6, 0, [ref('alh_bob_crane.action_report_inspection_task')])]"/>
            </field>
        </record>
    </data>
</odoo>
