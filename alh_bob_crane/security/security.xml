<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Privilege Category for Inspection Management -->
    <!-- ========================================================= -->
    <record model="res.groups.privilege" id="res_groups_privilege_inspection">
        <field name="name">Inspection</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

     <!-- ========================================================= -->
    <!-- Project Manager Group -->
    <!-- ========================================================= -->

     <record model="res.groups" id="group_project_manaager_admin">
        <field name="name">Project Manager</field>
    </record>

      <!-- ========================================================= -->
    <!-- Finance Manager Group -->
    <!-- ========================================================= -->

     <record model="res.groups" id="group_finance_manaager_admin">
        <field name="name">Finance Manager</field>
    </record>

       <record model="res.groups" id="group_timesheet_collection">
        <field name="name">Timesheet Collection</field>
    </record>



    <!-- ========================================================= -->
    <!-- Inspection User Group -->
    <!-- ========================================================= -->
    <record id="group_inspection_user" model="res.groups">
        <field name="name">Inspection User</field>
        <field name="comment">Can view and manage their assigned Inspection tasks.</field>
        <field name="privilege_id" ref="res_groups_privilege_inspection"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ========================================================= -->
    <!-- Inspection Manager Group -->
    <!-- ========================================================= -->
    <record id="group_inspection_manager" model="res.groups">
        <field name="name">Inspection Manager</field>
        <field name="comment">Full access to all Inspection configurations and records.</field>
        <field name="privilege_id" ref="res_groups_privilege_inspection"/>
        <field name="implied_ids" eval="[(4, ref('group_inspection_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>



