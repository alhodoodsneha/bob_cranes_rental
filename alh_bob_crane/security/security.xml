    </record>

    <!-- Planning User -->
    <record id="group_operations_planning_user" model="res.groups">
        <field name="name">Planning User</field>
        <field name="privilege_id" ref="res_groups_privilege_planning"/>
    </record>

     <record id="operations_planning_user_own_rule" model="ir.rule">
        <field name="name">Operations Planning - User Own Records</field>
        <field name="model_id" ref="model_project_operations_planning"/>
        <field name="groups" eval="[(4, ref('alh_bob_crane.group_operations_planning_user'))]"/>
        <field name="domain_force">['|',('user_id', '=', user.id),('project_id.user_id', '=', user.id)]</field>
    </record>

      <record id="operations_planning_manager_all_rule" model="ir.rule">
         <field name="name">Operations Planning - manager All</field>
         <field name="model_id" ref="model_project_operations_planning"/>
         <field name="groups" eval="[(4, ref('alh_bob_crane.group_operations_planning_manager'))]"/>
          <field name="domain_force">[(1,'=',1)]</field>
    </record>

