<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Risk Incident Kanban View -->
    <record id="risk_incident_view_kanban" model="ir.ui.view">
        <field name="name">risk.incident.view.kanban</field>
        <field name="model">risk.incident</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    records_draggable="true" default_order="state"
                    examples="project">
                <field name="risk_incident"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="crm_lead_id"/>
                <progressbar field="state"
                             colors='{"new": "warning","to_do": "info", "cancel": "danger", "progress": "muted",  "done": "success", "advanced": "primary"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong>
                                    <field name="risk_incident"
                                           style="font-size:20px;"/>
                                    <br/>
                                    <field name="task_id"/>
                                    <field name="crm_lead_id"/>
                                    <field name="project_id" invisible="1"/>
                                    <br/>
                                    <field name="activity_ids"
                                           widget="kanban_activity"/>
                                    <field name="user_id"
                                           widget="many2one_avatar_user"/>
                                </strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--    Risk Incident list View-->
    <record id="risk_incident_view_list" model="ir.ui.view">
        <field name="name">risk.incident.view.list</field>
        <field name="model">risk.incident</field>
        <field name="arch" type="xml">
            <list string="Risk Incidents">
                <field name="risk_incident"/>
                <field name="project_id" invisible="1"/>
                <field name="task_id"/>
                <field name="crm_lead_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="activity_ids" widget="list_activity"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--    Risk Incident Pivot View-->
    <record id="risk_incident_view_pivot" model="ir.ui.view">
        <field name="name">risk.incident.view.pivot</field>
        <field name="model">risk.incident</field>
        <field name="arch" type="xml">
            <pivot string="Project Risks Incidents" display_quantity="1"
                   sample="1">
                <field name="risk_incident" type="row"/>
                <field name="task_id" type="row"/>
                <field name="crm_lead_id" type="row"/>
                <field name="project_id" type="row" invisible="1"/>
                <field name="user_id" type="col"/>
            </pivot>
        </field>
    </record>
    <!--    Risk Incident Graph View-->
    <record id="risk_incident_view_graph" model="ir.ui.view">
        <field name="name">risk.incident.view.graph</field>
        <field name="model">risk.incident</field>
        <field name="arch" type="xml">
            <graph string="Project Risks Incidents" sample="1">
                <field name="risk_incident"/>
                <field name="task_id"/>
                <field name="crm_lead_id"/>
                <field name="project_id" invisible="1"/>
                <field name="user_id"/>
            </graph>
        </field>
    </record>
    <!--    Risk Incident Form View-->
    <record id="risk_incident_view_form" model="ir.ui.view">
        <field name="name">risk.incident.view.form</field>
        <field name="model">risk.incident</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="risk_incident" style="font-size:30px;"/>
                    <group>
                        <group>
                            <field name="project_id" invisible="1"/>
                            <field name="task_id"/>
                            <field name="crm_lead_id"/>
                            <field name="user_id"/>
                            <field name="deadline"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="note"/>
                        </page>
                        <page string="Risk Management" name="risk_management">
                            <field name="incident_image" widget='image'
                                   class="oe_avatar"/>

                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>
</odoo>