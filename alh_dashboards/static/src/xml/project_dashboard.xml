<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="alh_dashboards.active_projects_dashboard">
        <div class="o_active_dashboard container-fluid p-4">
            <style>
               html, body {
                    height: auto !important;
                    overflow-y: auto !important;
                }
          </style>

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-primary">
                    Active Projects Dashboard
                </h2>
            </div>

            <!-- KPI CARDS -->
            <div class="row g-4 mb-4">

                <t t-foreach="state.kpis" t-as="kpi" t-key="kpi.label">
                    <div class="col-12 col-md-3">
                        <div class="card shadow-sm border-0 rounded-4 h-100">
                            <div class="card-body text-center">
                                <h6 class="text-muted"><t t-esc="kpi.label"/></h6>
                                <h2 class="fw-bold"><t t-esc="kpi.value"/></h2>
                                <div class="progress mt-2" style="height:6px;">
                                    <div class="progress-bar"
                                         role="progressbar"
                                         t-att-style="'width:' + kpi.percent + '%'">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

            </div>

            <!-- CHARTS SECTION -->
            <div class="row g-4 mb-4">

                <!-- PIE CHART -->
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Project Status Distribution</h5>
                        </div>
                        <div class="card-body" style="height:500px;">
                            <canvas id="statusChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- BAR CHART -->
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Projects per Manager</h5>
                        </div>
                        <div class="card-body" style="height:500px;">
                            <canvas id="managerChart"></canvas>
                        </div>
                    </div>
                </div>

            </div>

            <div class="row g-4 justify-content-center">

                <t t-foreach="state.projects" t-as="project" t-key="project.id">

                    <div class="col-12 col-lg-6">

                        <div class="card shadow-sm border-0 rounded-4 h-100">
                            <div class="card-body">

                                <!-- Project Header -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0">
                                        <t t-esc="project.name"/>
                                    </h5>
                                    <span class="badge bg-primary">
                                        <t t-esc="project.status"/>
                                    </span>
                                </div>

                                <!-- Task Count Badges -->
                                <div class="mb-3">
                                    <span class="badge bg-success me-2">
                                        Done: <t t-esc="project.task_summary.done"/>
                                    </span>
                                    <span class="badge bg-warning me-2">
                                        In Progress: <t t-esc="project.task_summary.progress"/>
                                    </span>
                                    <span class="badge bg-danger">
                                        Pending: <t t-esc="project.task_summary.pending"/>
                                    </span>
                                </div>

                                <!-- Overall Progress -->
                                <div class="mb-3">
                                    <small class="text-muted">Overall Completion</small>
                                    <div class="progress" style="height:8px;">
                                        <div class="progress-bar bg-success"
                                             t-att-style="'width:' + project.completion + '%'">
                                        </div>
                                    </div>
                                    <small><t t-esc="project.completion"/>%</small>
                                </div>

                                <div class="row text-center mb-3">

                                    <div class="col-4">
                                        <small class="text-muted d-block">Project Value</small>
                                        <strong class="text-dark">
                                            ₹ <t t-esc="project.project_value"/>
                                        </strong>
                                    </div>

                                    <div class="col-4">
                                        <small class="text-muted d-block">Invoiced</small>
                                        <strong class="text-success">
                                            ₹ <t t-esc="project.invoiced"/>
                                        </strong>
                                    </div>

                                    <div class="col-4">
                                        <small class="text-muted d-block">Invoice Due</small>
                                        <strong t-att-class="
                                            project.invoice_due > 0 ? 'text-danger' : 'text-success'">
                                            ₹ <t t-esc="project.invoice_due"/>
                                        </strong>
                                    </div>

                                </div>


                                <!-- FINANCIAL PROGRESS BAR -->
                                <div class="mb-3">
                                    <small class="text-muted">Billing Progress</small>
                                    <div class="progress" style="height:8px;">
                                        <div class="progress-bar bg-success"
                                             t-att-style="'width:' + project.billing_percent + '%'">
                                        </div>
                                    </div>
                                    <small>
                                        <t t-esc="project.billing_percent"/>% Billed
                                    </small>
                                </div>

                                <!-- PLANNED DATES -->
                                <div class="mb-3">

                                    <div class="row text-center">

                                        <div class="col-4">
                                            <small class="text-muted d-block">Planned Start</small>
                                            <strong>
                                                <t t-esc="project.planned_start"/>
                                            </strong>
                                        </div>

                                        <div class="col-4">
                                            <small class="text-muted d-block">Planned End</small>
                                            <strong>
                                                <t t-esc="project.planned_end"/>
                                            </strong>
                                        </div>

                                        <div class="col-4">
                                            <small class="text-muted d-block">Duration</small>
                                            <strong>
                                                <t t-esc="project.duration"/> days
                                            </strong>
                                        </div>

                                    </div>

                                    <!-- Timeline Progress -->
                                    <div class="mt-3">
                                        <small class="text-muted">Timeline Progress</small>
                                        <div class="progress" style="height:8px;">
                                            <div class="progress-bar"
                                                 t-att-class="
                                                    project.timeline_percent > 100 ?
                                                    'progress-bar bg-danger' :
                                                    'progress-bar bg-info'"
                                                 t-att-style="'width:' + (project.timeline_percent > 100 ? 100 : project.timeline_percent) + '%'">
                                            </div>
                                        </div>

                                        <small>
                                            <t t-esc="project.timeline_percent"/>%
                                            <t t-if="project.timeline_percent > 100">
                                                <span class="text-danger ms-2">Overdue</span>
                                            </t>
                                        </small>
                                    </div>

                                </div>

                                <!-- Donut Chart -->
                                <div style="height:250px;">
                                    <canvas t-att-id="'taskChart_' + project.id"></canvas>
                                </div>

                            </div>
                        </div>

                    </div>

                </t>

            </div>

            <!-- RECENT PROJECTS TABLE -->
            <div class="card shadow-sm border-0 rounded-4 mt-3">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Recent Active Projects</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Manager</th>
                                <th>Deadline</th>
                                <th>Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.projects" t-as="project" t-key="project.id">
                                <tr>
                                    <td><t t-esc="project.name"/></td>
                                    <td><t t-esc="project.manager"/></td>
                                    <td><t t-esc="project.planned_end"/></td>
                                    <td>
                                        <div class="progress" style="height:6px;">
                                            <div class="progress-bar bg-success"
                                                 t-att-style="'width:' + project.completion + '%'">
                                            </div>
                                        </div>
                                        <small><t t-esc="project.completion"/>%</small>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </t>
</templates>
