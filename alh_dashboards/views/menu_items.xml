<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="action_active_projects_dashboard_page" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">alh_dashboards.active_projects_dashboard</field>
    </record>

    <record id="action_eq_dashboard_page" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">alh_dashboards.equipment_dashboard</field>
    </record>


    <menuitem id="menu_custom_dashboard_root"
          name="Dashboards"
              groups="group_custom_dashboard"
          web_icon="alh_dashboards,static/src/img/dash.png"
          sequence="5"/>

    <menuitem id="menu_custom_project_dashboard"
          name="Active Projects"
          parent="menu_custom_dashboard_root"
          action="action_active_projects_dashboard_page"
          sequence="1"/>

    <menuitem id="menu_custom_equipments_dashboard"
          name="Equipments"
          parent="menu_custom_dashboard_root"
          action="action_eq_dashboard_page"
          sequence="1"/>

