<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_account_journal_form_inherited_property_rental" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.rental</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']"
                   position="after">
                <field name="is_pdc"/>
                <field name="credit_account_id"
                       required="is_pdc == True"
                       invisible="is_pdc == False"/>
                <field name="debit_account_id"
                       required="is_pdc == True"
                       invisible="is_pdc == False"/>
            </xpath>
        </field>
    </record>

      <record id="account_move_form_view_inherited_bob_crane" model="ir.ui.view">
        <field name="name">account.move.form.inherit.bob.crane</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']"
                   position="after">
                <field name="pdc_received_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_inherit_bob_crane" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.bob.crane</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="pdc_received_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>