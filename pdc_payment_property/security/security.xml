<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="pdc_payment_received_company_rule" model="ir.rule">
        <field name="name">PDC Received : Multi Company</field>
        <field name="model_id" ref="model_pdc_payment_received"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pdc_payment_submit_company_rule" model="ir.rule">
        <field name="name">PDC Submit: Multi Company</field>
        <field name="model_id" ref="model_pdc_payment_submit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>